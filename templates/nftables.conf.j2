# ===================================================================
# nftables managed by Ansible
# CIS Controls: 4.3.3 to 4.3.10
# Do not edit manually - changes may be overwritten
# ===================================================================

table inet {{ nftable_name }} {

  # 4.3.5 Ensure base chains exist
  chain input {
    type filter hook input priority 0;
    policy drop;

    # 4.3.6 Loopback traffic configuration
    iif "lo" accept
    ip saddr 127.0.0.0/8 drop
    ip6 saddr ::1 drop

    # 4.3.7 Allow established/related connections
    ct state established,related accept

    # Allow SSH, DNS, HTTP, HTTPS
    tcp dport { 22, 80, 443 } ct state new accept
    udp dport 53 accept
    tcp dport 53 accept

    # Optional: ICMP ping
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    # Log and drop others
    counter packets 0 bytes 0 log prefix "Dropped by nftables: " drop
  }

  chain forward {
    type filter hook forward priority 0;
    policy drop;
  }

  chain output {
    type filter hook output priority 0;
    policy drop;

    # Allow loopback
    oif "lo" accept

    # Allow established/related responses (SSH, DNS replies, etc.)
    ct state established,related accept

    # Allow DNS lookups
    udp dport 53 accept
    tcp dport 53 accept

    # Allow SSH client connections if needed (e.g., outbound to git servers)
    tcp dport 22 accept

    # (Optional) Allow HTTP/HTTPS if server needs to fetch packages or APIs
    tcp dport { 80, 443 } accept
   }
}
