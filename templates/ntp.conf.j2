# /etc/ntp.conf

# Access control rules
restrict default kod nomodify notrap nopeer noquery
restrict -6 default kod nomodify notrap nopeer noquery

# Allow localhost to query the server with full access
restrict 127.0.0.1
restrict -6 ::1

# Allow specific IP addresses or subnets with full access
restrict 192.168.1.0 mask 255.255.255.0
restrict 10.0.0.0 mask 255.0.0.0

# Deny all other clients
restrict default ignore

# Specify your NTP servers
server time_server1
server time_server2

# Set the user for the NTP service
ntp