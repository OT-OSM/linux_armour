*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
-A INPUT -s 127.0.0.0/8 -j DROP

# Established/related
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

# Allowed services (by port)
{% for service in allowed_services %}
{% if service == 'ssh' %}-A INPUT -p tcp --dport 22 -j ACCEPT{% endif %}
{% if service == 'http' %}-A INPUT -p tcp --dport 80 -j ACCEPT{% endif %}
{% if service == 'https' %}-A INPUT -p tcp --dport 443 -j ACCEPT{% endif %}
{% if service == 'dns' %}-A INPUT -p tcp --dport 53 -j ACCEPT
-A INPUT -p udp --dport 53 -j ACCEPT{% endif %}
{% endfor %}

# Additional allowed ports
{% for port in allowed_ports %}
-A INPUT -p {{ port.proto }} --dport {{ port.port }} -j ACCEPT
{% endfor %}

COMMIT
