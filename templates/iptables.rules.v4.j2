*filter
# ============================================================
# Managed by Ansible
# CIS Controls
# Default policy is DROP, but essential traffic is allowed
# ============================================================

:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# ----------------
# Loopback traffic
# ----------------
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
-A INPUT -s 127.0.0.0/8 -j DROP

# -------------------
# Established/related
# -------------------
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

# --------------------------------
# Additional allowed inbound ports
# --------------------------------
{% for port in allowed_ports %}
-A INPUT -p {{ port.proto }} --dport {{ port.port }} -j ACCEPT
{% endfor %}

# ----------------------
# Allowed outbound ports
# ----------------------
{% for port in allowed_ports %}
-A OUTPUT -p {{ port.proto }} --dport {{ port.port }} -j ACCEPT
{% endfor %}

# --------------------------
# Explicit final DROP/ACCEPT
# --------------------------
-A INPUT -j DROP
-A FORWARD -j DROP
-A OUTPUT -j ACCEPT

COMMIT
